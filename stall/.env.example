# 百度语音识别（短语音识别）应用凭证 —— 复制本文件为 .env 填入真实值，.env 不进 git。
# 支持多个 key：轮询分担并发（免费版有并发上限）与免费额度（每个 key 各约 200 万次）。
BAIDU_KEYS=[{"key":"你的API_Key","secret":"你的Secret_Key"}]

# 以后加 key 就在数组里追加一项：
# BAIDU_KEYS=[{"key":"k1","secret":"s1"},{"key":"k2","secret":"s2"},{"key":"k3","secret":"s3"}]

# 旧单 key 写法也兼容（与 BAIDU_KEYS 二选一）：
# BAIDU_KEY=你的API_Key
# BAIDU_SECRET=你的Secret_Key
